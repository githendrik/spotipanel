#ifndef CREDENTIALS_H
#define CREDENTIALS_H

// WiFi credentials
const char* WIFI_SSID = "your_wifi_ssid_here";
const char* WIFI_PASSWORD = "your_wifi_password_here";

// Spotify API credentials
// Get these from https://developer.spotify.com/dashboard
const char* SPOTIFY_CLIENT_ID = "your_spotify_client_id_here";
const char* SPOTIFY_CLIENT_SECRET = "your_spotify_client_secret_here";

// Generate with: python3 tools/get_token.py or node tools/get_token.js
// Required scopes: playlist-read-private user-modify-playback-state user-read-playback-state streaming
const char* SPOTIFY_REFRESH_TOKEN = "your_spotify_refresh_token_here";

// Device configuration
const char* PLAYLIST_ID = "your_spotify_playlist_id_here";
const char* TARGET_SPEAKER = "your_spotify_connect_speaker_name_here";

#endif
